{
  "name": "ai-influencer-factory-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "npx prisma generate",
    "start": "node scripts/migrate-deploy.mjs && node src/server.js",
    "db:migrate": "node scripts/migrate-deploy.mjs",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "postinstall": "prisma generate",
    "test": "scripts/with-test-postgres.sh node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --test --test-concurrency=1 test/*.test.js",
    "start:server": "node src/server.js",
    "db:migrate:create": "npx prisma migrate dev --create-only"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "prisma": "^6.5.0",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2",
      "effect": "^3.22.4"
    }
  }
}
