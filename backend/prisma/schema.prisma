generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  runtime                = "nodejs"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

// Connection URL lives in prisma.config.mjs (Prisma 7).
datasource db {
  provider = "postgresql"
}

// ─── CHARACTERS ───────────────────────────────────────────────

model Character {
  id                String   @id @default(cuid())
  characterId       String   @unique @map("character_id") // INFL-001, INFL-002...
  name              String
  characterType     String?  @map("character_type")
  niche             String?
  persona           String?
  gender            String?
  ethnicity         String?
  eyeColor          String?  @map("eye_color")
  age               String?
  skinConditions    String?  @map("skin_conditions")
  advancedFeatures  String?  @map("advanced_features")
  optionalPrompt    String?  @map("optional_prompt")
  aspectRatio       String   @default("9:16") @map("aspect_ratio")
  qualitySetting    String   @default("4K") @map("quality_setting")
  referenceImageUrl String?  @map("reference_image_url")
  // Monotonic counter of generated images; part of the generation idempotency key.
  imageGenerations  Int      @default(0) @map("image_generations")

  // B-O-P-A Framework
  bopaBackground    String?  @map("bopa_background")
  bopaOutfit        String?  @map("bopa_outfit")
  bopaPoses         String?  @map("bopa_poses")
  bopaAngles        String?  @map("bopa_angles")

  targetPlatforms   String[] @map("target_platforms")
  status            String   @default("active")
  followerCount     Int      @default(0) @map("follower_count")
  totalViews        Int      @default(0) @map("total_views")
  engagementRate    String   @default("0.00") @map("engagement_rate")
  notes             String?

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  content           Content[]
  submissions       CampaignSubmission[]
  scripts           Script[]
  pipelineItems     PipelineItem[]
  images            CharacterImage[]
  versions          CharacterVersion[]
  // Latest published version (the row's own fields are the editable draft).
  publishedVersionId String?  @map("published_version_id")

  @@map("characters")
}

// ─── CHARACTER IMAGES ────────────────────────────────────────
// Generated candidates and replaced references. Generation never changes the
// character's reference image; only an explicit promotion does.

model CharacterImage {
  id              String   @id @default(cuid())
  characterId     String   @map("character_id")
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  imageUrl        String   @map("image_url")
  status          String   @default("candidate") // candidate | reference | replaced_reference
  source          String   // generated | manual
  provider        String?
  model           String?
  reservationId   String?  @unique @map("reservation_id")
  generationIndex Int?     @map("generation_index")
  // Identity of the image: sha256 of its bytes when known (checksum); always
  // a sha256 of its URL (fingerprint), since media is not stored yet.
  fingerprint     String?
  checksum        String?
  // What produced a generated image: version, prompt hash, references sent.
  characterVersionId String? @map("character_version_id")
  generationInputs   Json?   @map("generation_inputs")
  rights          RightsRecord[]
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([characterId, generationIndex])
  @@index([characterId, createdAt])
  @@map("character_images")
}

// ─── CONTENT ──────────────────────────────────────────────────

model Content {
  id              String   @id @default(cuid())
  title           String
  contentType     String?  @map("content_type")
  platform        String?
  scheduledDate   String?  @map("scheduled_date")
  status          String   @default("scheduled")
  caption         String?
  hashtags        String?
  motionPrompt    String?  @map("motion_prompt")
  views           Int      @default(0)
  likes           Int      @default(0)
  notes           String?

  // Set only when created from an approved pipeline revision. Unique so the
  // same approved snapshot can never be scheduled twice.
  scheduleKey     String?  @unique @map("schedule_key")
  approvedHash    String?  @map("approved_hash")
  mediaType       String?  @map("media_type") // image | video
  // Planning only: the approved destination instant and zone, and
  // cancellation (a cancelled entry can never be delivered).
  scheduledAt      DateTime? @map("scheduled_at")
  scheduleTimezone String?   @map("schedule_timezone")
  cancelledAt      DateTime? @map("cancelled_at")
  cancelledBy      String?   @map("cancelled_by")
  cancelReason     String?   @map("cancel_reason")
  imageUrl        String?  @map("image_url")
  videoUrl        String?  @map("video_url")

  characterId     String   @map("character_id")
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  pipelineItems   PipelineItem[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("content")
}

// ─── CAMPAIGNS ────────────────────────────────────────────────

model Campaign {
  id              String   @id @default(cuid())
  name            String
  brand           String?
  platform        String?
  brief           String?
  requirements    String?
  payoutAmount    String?  @map("payout_amount")
  deadline        String?
  status          String   @default("active")
  // Currency of the planned payout (Package G). Planned, invoiced and received
  // money are separate records; nothing here is "earned" by itself.
  currency        String   @default("USD")
  // A real, authorized sponsor relationship (brief section 3): agreement
  // reference, who the sponsor is, when it was authorized and the paid-
  // promotion disclosure. Required before characters are submitted.
  sponsorLegalName    String?   @map("sponsor_legal_name")
  sponsorAgreementRef String?   @map("sponsor_agreement_ref")
  sponsorAuthorizedAt DateTime? @map("sponsor_authorized_at")
  sponsorAuthorizedBy String?   @map("sponsor_authorized_by")
  sponsorDisclosure   String?   @map("sponsor_disclosure")
  invoices        CampaignInvoice[]
  receipts        CampaignReceipt[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  submissions     CampaignSubmission[]

  @@map("campaigns")
}

// ─── CAMPAIGN SUBMISSIONS ─────────────────────────────────────

model CampaignSubmission {
  id              String   @id @default(cuid())
  submissionUrl   String?  @map("submission_url")
  notes           String?
  payout          Float    @default(0)
  status          String   @default("pending")

  characterId     String   @map("character_id")
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  campaignId      String   @map("campaign_id")
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  submittedAt     DateTime @default(now()) @map("submitted_at")

  @@map("campaign_submissions")
}

// ─── TRENDS ──────────────────────────────────────────────────

model Trend {
  id            String   @id @default(cuid())
  platform      String   // TikTok, Instagram, YouTube
  topic         String
  description   String?
  hashtags      String[] @default([])
  // Null = unknown. Only real, sourced data may ever fill this in.
  trendScore    Float?   @map("trend_score")
  source        String?  // URL or reference
  provenance    String   @default("unknown") // simulated_fixture | manual | verified_source
  // manual_idea | observation | simulated_fixture
  kind          String   @default("simulated_fixture")
  // Observations only: where and when it was seen, and exactly what was seen.
  sourceUrl     String?  @map("source_url")
  observedAt    DateTime? @map("observed_at")
  observation   String?
  recordedBy    String?  @map("recorded_by")
  status        String   @default("new") // new, scripted, used, expired

  scripts       Script[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("trends")
}

// ─── SCRIPTS ─────────────────────────────────────────────────

model Script {
  id            String   @id @default(cuid())
  title         String
  hook          String?  // Opening hook line
  body          String?  // Main script content
  callToAction  String?  @map("call_to_action")
  platform      String?
  duration      String?  // "15s", "30s", "60s"
  tone          String?  // funny, educational, dramatic, etc.
  status        String   @default("draft") // draft, approved, in_production, completed
  // Latest ScriptVersion number; the fields above mirror that version.
  currentVersion Int     @default(0) @map("current_version")

  trendId       String?  @map("trend_id")
  trend         Trend?   @relation(fields: [trendId], references: [id])

  characterId   String?  @map("character_id")
  character     Character? @relation(fields: [characterId], references: [id])

  pipelineItems PipelineItem[]
  versions      ScriptVersion[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("scripts")
}

// ─── PIPELINE ITEMS ──────────────────────────────────────────

model PipelineItem {
  id            String    @id @default(cuid())
  stage         String    @default("draft") // draft, content_generated, review, approved, scheduled, published

  scriptId      String?   @map("script_id")
  script        Script?   @relation(fields: [scriptId], references: [id])

  contentId     String?   @map("content_id")
  content       Content?  @relation(fields: [contentId], references: [id])

  characterId   String    @map("character_id")
  character     Character @relation(fields: [characterId], references: [id])

  imageUrl      String?   @map("image_url")
  videoUrl      String?   @map("video_url")
  caption       String?
  hashtags      String?

  scheduledDate String?   @map("scheduled_date")
  platform      String?
  // Destination schedule (part of the approved snapshot, Package E): the IANA
  // zone of the destination, the wall time there, and the resolved instant.
  scheduledAt      DateTime? @map("scheduled_at")
  scheduleTimezone String?   @map("schedule_timezone")
  scheduleLocal    String?   @map("schedule_local")
  // Extra destinations for the same original (cross-post), part of the
  // approved snapshot. One original posted to several places is one job.
  crossPostDestinations String[] @default([]) @map("cross_post_destinations")

  reviewNotes   String?   @map("review_notes")
  approvedAt    DateTime? @map("approved_at")
  rejectedAt    DateTime? @map("rejected_at")

  // Exact-version approval: every publish-relevant change bumps revision and
  // clears approval. approvedHash is the snapshot hash the reviewer approved.
  revision          Int     @default(1)
  approvedRevision  Int?    @map("approved_revision")
  approvedHash      String? @map("approved_hash")
  approvedBy        String? @map("approved_by")
  // Durable key of an unfinished generation workflow, reused on retry.
  activeWorkflowKey String? @map("active_workflow_key")
  // Generation claim (fencing token). Set atomically before any spend; while
  // it is live, scheduling, approval and edits are refused, and a result is
  // applied only by the holder of this exact token at the expected revision.
  // Character version this item was written for; part of the approved snapshot.
  characterVersionId  String?   @map("character_version_id")
  // Content package (all part of the approved snapshot):
  scriptVersionId String?  @map("script_version_id")
  // [{ shotIndex, shotKey, kind, url, durationSec, durationSource, reservationId }]
  shotMedia       Json     @default("[]") @map("shot_media")
  disclosure      String?
  exportSettings  Json?    @map("export_settings")
  generationClaim     String?   @map("generation_claim")
  generationClaimedAt DateTime? @map("generation_claimed_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("pipeline_items")
}

// ─── SPENDING LEDGER ─────────────────────────────────────────
// Durable reservations for paid provider calls. Amounts in integer micro-USD.

model GenerationReservation {
  id             String   @id @default(cuid())
  provider       String
  model          String
  amountMicros   BigInt   @map("amount_micros")
  actualMicros   BigInt?  @map("actual_micros")
  state          String   // reserved | settled | released | outcome_unknown
  day            String   // YYYY-MM-DD (UTC)
  month          String   // YYYY-MM (UTC)
  idempotencyKey String?  @unique @map("idempotency_key")
  requestHash    String?  @map("request_hash")
  result         Json?
  // Pricing context at reservation time (required since Package D).
  currency       String   @default("USD")
  priceVersion   String?  @map("price_version")
  capTimezone    String?  @map("cap_timezone")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([day])
  @@index([month])
  @@map("generation_reservations")
}

// ─── GENERATION APPLICATIONS ─────────────────────────────────
// One row per provider result applied to a pipeline item, written in the same
// transaction as the item change. Its presence means "already applied": a
// replay of that reservation returns the recorded result and changes nothing.

model GenerationApplication {
  reservationId  String   @id @map("reservation_id")
  pipelineItemId String   @map("pipeline_item_id")
  kind           String   // image | video
  mediaUrl       String   @map("media_url")
  revision       Int      // item revision produced by this application
  appliedAt      DateTime @default(now()) @map("applied_at")
  // Actual inputs: version used, sha256 of the prompt (not the prompt), and
  // the fingerprints of references actually sent ("none" when not sent).
  characterVersionId String? @map("character_version_id")
  promptHash         String? @map("prompt_hash")
  referencesSent     String[] @default([]) @map("references_sent")
  conditioning       String  @default("none")

  @@index([pipelineItemId])
  @@map("generation_applications")
}

// ─── SESSIONS ────────────────────────────────────────────────
// Revocable, expiring API sessions. Only a SHA-256 hash of the session token
// is stored; the token itself is shown to the client once.

model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique @map("token_hash")
  principalId  String    @map("principal_id")
  role         String    // owner | editor | reviewer
  workspaceId  String    @default("default") @map("workspace_id")
  authProvider String    @map("auth_provider")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastSeenAt   DateTime? @map("last_seen_at")

  @@index([principalId])
  @@map("sessions")
}

// ─── AUDIT EVENTS ────────────────────────────────────────────
// Redacted evidence of who did what: actor, route pattern, target id, result
// and correlation id. Never request bodies, tokens or provider payloads.

model AuditEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?  @map("actor_id")
  actorRole  String?  @map("actor_role")
  sessionId  String?  @map("session_id")
  action     String   // e.g. "POST /api/pipeline/:id/approve" or "auth.session.create"
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  status     Int
  outcome    String   // success | denied | failed
  errorCode  String?  @map("error_code")
  requestId  String?  @map("request_id")

  @@index([at])
  @@index([targetId])
  @@index([actorId])
  @@map("audit_events")
}

// ─── CHARACTER VERSIONS ──────────────────────────────────────
// Immutable published snapshots of a character. identity = what must stay
// the same across content; styling = per-shot defaults that may vary.

model CharacterVersion {
  id           String   @id @default(cuid())
  characterId  String   @map("character_id")
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  version      Int
  identity     Json
  styling      Json
  // [{ imageId, fingerprint, checksum }] pinned at publish time
  references   Json     @default("[]")
  contentHash  String   @map("content_hash")
  publishedBy  String?  @map("published_by")
  publishedAt  DateTime @default(now()) @map("published_at")
  note         String?

  @@unique([characterId, version])
  @@map("character_versions")
}

// ─── RIGHTS RECORDS ──────────────────────────────────────────
// Append-only rights/consent records for a reference image; the newest one
// applies. A free-text checkbox is not enough: basis, holder, permitted uses
// and (for a real person's likeness) a consent reference are recorded, and
// the owner approves the record before any provider may receive the image.

model RightsRecord {
  id                  String    @id @default(cuid())
  imageId             String    @map("image_id")
  image               CharacterImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  basis               String    // generated_synthetic | owned_original | licensed | consented_likeness
  holder              String
  permittedUses       String[]  @map("permitted_uses") // provider_input | publication | training
  likenessOfRealPerson Boolean  @default(false) @map("likeness_of_real_person")
  consentReference    String?   @map("consent_reference")
  licenseReference    String?   @map("license_reference")
  expiresAt           DateTime? @map("expires_at")
  notes               String?
  recordedBy          String    @map("recorded_by")
  recordedAt          DateTime  @default(now()) @map("recorded_at")
  approvedBy          String?   @map("approved_by")
  approvedAt          DateTime? @map("approved_at")

  @@index([imageId, recordedAt])
  @@map("rights_records")
}

// ─── SCRIPT VERSIONS ─────────────────────────────────────────
// Immutable script versions with their shot plan. Editing a script creates
// a new version; content pins one, so an edit never silently changes
// approved content.

model ScriptVersion {
  id                 String   @id @default(cuid())
  scriptId           String   @map("script_id")
  script             Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  version            Int
  hook               String?
  body               String?
  callToAction       String?  @map("call_to_action")
  speakingPaceWpm    Int      @map("speaking_pace_wpm")
  targetDurationSec  Int      @map("target_duration_sec")
  // [{ claim, sourceUrl?, observedAt?, basis: "source" | "fictional" }]
  evidence           Json     @default("[]")
  shotPlan           Json     @map("shot_plan")
  plannedDurationSec Float    @map("planned_duration_sec")
  characterVersionId String?  @map("character_version_id")
  contentHash        String   @map("content_hash")
  createdBy          String?  @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([scriptId, version])
  @@map("script_versions")
}

// ─── GENERATION JOBS ─────────────────────────────────────────
// Durable record of every paid workflow and each step's progress, so a
// restart can tell "never sent" (safe to release) from "may have been sent"
// (must be reconciled before anything is bought again).

model GenerationJob {
  id             String    @id @default(cuid())
  kind           String    // pipeline.generate-content | character.generate-image | character.generate-video
  targetType     String    @map("target_type")
  targetId       String    @map("target_id")
  workflowKey    String    @map("workflow_key")
  requestHash    String?   @map("request_hash")
  // queued | running | awaiting_reconciliation | awaiting_application | succeeded | failed | cancelled
  state          String    @default("queued")
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  errorCode      String?   @map("error_code")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  finishedAt     DateTime? @map("finished_at")
  steps          GenerationStep[]

  @@index([state])
  @@index([targetId])
  @@map("generation_jobs")
}

model GenerationStep {
  id                   String   @id @default(cuid())
  jobId                String   @map("job_id")
  job                  GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  index                Int
  kind                 String   // image | video
  provider             String
  model                String
  idempotencyKey       String   @map("idempotency_key")
  reservationId        String?  @map("reservation_id")
  // pending | reserved | submitting | accepted | succeeded | applied | not_submitted |
  // outcome_unknown | settlement_failed | application_failed | superseded |
  // resolved_not_charged | resolved_charged_no_result | resolved_charged_with_result | replayed
  state                String   @default("pending")
  providerRequestId    String?  @map("provider_request_id")
  vendorIdempotencyKey String?  @map("vendor_idempotency_key")
  result               Json?
  errorCode            String?  @map("error_code")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  // Bumped on every change; reconciliation decisions compare-and-swap on it.
  revision        Int      @default(0)
  reconciliations      ReconciliationRecord[]

  @@unique([jobId, index])
  @@index([state])
  @@map("generation_steps")
}

// Who resolved an uncertain step, how, and on what evidence. Append-only.
model ReconciliationRecord {
  id            String   @id @default(cuid())
  stepId        String   @map("step_id")
  step          GenerationStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  reservationId String?  @map("reservation_id")
  method        String   // provider_check | operator
  resolution    String   // not_charged | charged_no_result | charged_with_result | still_pending
  evidence      String
  actualMicros  BigInt?  @map("actual_micros")
  resultUrl     String?  @map("result_url")
  resolvedBy    String   @map("resolved_by")
  resolvedAt    DateTime @default(now()) @map("resolved_at")

  @@index([stepId])
  @@map("reconciliation_records")
}

/// An export of one approved snapshot. The manifest is canonical JSON; the
/// same approved content always produces the same manifest hash.
model ExportManifest {
  id             String   @id @default(cuid())
  pipelineItemId String   @map("pipeline_item_id")
  revision       Int
  snapshotHash   String   @map("snapshot_hash")
  manifestHash   String   @map("manifest_hash")
  manifest       Json
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([pipelineItemId, manifestHash])
  @@index([pipelineItemId])
  @@map("export_manifests")
}

/// One publication of one original (a calendar entry from an approval) to its
/// approved destinations. Deliveries hold the per-destination truth.
model PublishJob {
  id             String   @id @default(cuid())
  contentId      String   @unique @map("content_id")
  pipelineItemId String   @map("pipeline_item_id")
  snapshotHash   String   @map("snapshot_hash")
  manifestHash   String   @map("manifest_hash")
  // queued | running | awaiting_reconciliation | awaiting_confirmation |
  // published | partially_published | simulated | failed | cancelled
  state          String   @default("queued")
  leaseOwner     String?  @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deliveries     PublishDelivery[]

  @@map("publish_jobs")
}

model PublishDelivery {
  id              String   @id @default(cuid())
  jobId           String   @map("job_id")
  job             PublishJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  platform        String
  accountRef      String?  @map("account_ref")
  // pending | submitting | processing | published | simulated | failed |
  // outcome_unknown | cancelled | resolved_published | resolved_not_published
  state           String   @default("pending")
  attempt         Int      @default(0)
  // Stable per attempt; sent as the platform's idempotency key where supported.
  clientRef       String?  @map("client_ref")
  remoteRequestId String?  @map("remote_request_id")
  remotePostId    String?  @map("remote_post_id")
  permalink       String?
  errorCode       String?  @map("error_code")
  simulated       Boolean  @default(false)
  submittedAt     DateTime? @map("submitted_at")
  confirmedAt     DateTime? @map("confirmed_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  // Bumped on every change; reconciliation decisions compare-and-swap on it.
  revision        Int      @default(0)
  reconciliations PublishReconciliation[]

  @@unique([jobId, platform])
  @@map("publish_deliveries")
}

model PublishReconciliation {
  id           String   @id @default(cuid())
  deliveryId   String   @map("delivery_id")
  delivery     PublishDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  method       String   // platform_check | operator
  resolution   String   // published | not_published | still_pending
  evidence     String
  remotePostId String?  @map("remote_post_id")
  permalink    String?
  resolvedBy   String   @map("resolved_by")
  resolvedAt   DateTime @default(now()) @map("resolved_at")

  @@index([deliveryId])
  @@map("publish_reconciliations")
}

/// One reading of one metric, from one source. Append-only: a wrong reading is
/// retracted (with a reason), never edited. Cumulative readings are "as of"
/// observedAt; period readings cover [periodStart, periodEnd).
model MetricObservation {
  id            String    @id @default(cuid())
  subjectType   String    @map("subject_type") // post | account
  subjectId     String    @map("subject_id")   // publish delivery id | character id
  platform      String
  metric        String
  kind          String    // cumulative | period
  value         BigInt
  observedAt    DateTime  @map("observed_at")
  periodStart   DateTime? @map("period_start")
  periodEnd     DateTime? @map("period_end")
  source        String    // manual | api | fixture
  sourceDetail  String?   @map("source_detail")
  dedupeKey     String    @unique @map("dedupe_key")
  recordedBy    String    @map("recorded_by")
  recordedAt    DateTime  @default(now()) @map("recorded_at")
  retractedAt   DateTime? @map("retracted_at")
  retractReason String?   @map("retract_reason")

  @@index([subjectType, subjectId, metric])
  @@index([observedAt])
  @@map("metric_observations")
}

/// An invoice actually issued to a sponsor. Voided, never deleted.
model CampaignInvoice {
  id           String    @id @default(cuid())
  campaignId   String    @map("campaign_id")
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  number       String
  amountMicros BigInt    @map("amount_micros")
  currency     String
  issuedAt     DateTime  @map("issued_at")
  dueAt        DateTime? @map("due_at")
  voidedAt     DateTime? @map("voided_at")
  voidReason   String?   @map("void_reason")
  recordedBy   String    @map("recorded_by")
  recordedAt   DateTime  @default(now()) @map("recorded_at")
  receipts     CampaignReceipt[]

  @@unique([campaignId, number])
  @@map("campaign_invoices")
}

/// Cash actually received, with evidence. Reversed, never deleted.
model CampaignReceipt {
  id            String    @id @default(cuid())
  campaignId    String    @map("campaign_id")
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  invoiceId     String?   @map("invoice_id")
  invoice       CampaignInvoice? @relation(fields: [invoiceId], references: [id])
  amountMicros  BigInt    @map("amount_micros")
  currency      String
  receivedAt    DateTime  @map("received_at")
  reference     String
  evidence      String
  reversedAt    DateTime? @map("reversed_at")
  reverseReason String?   @map("reverse_reason")
  recordedBy    String    @map("recorded_by")
  recordedAt    DateTime  @default(now()) @map("recorded_at")

  @@map("campaign_receipts")
}
