# AI Influencer Factory API - example configuration (no real values).
# Copy to .env for LOCAL use only. Never commit real secrets.
# Prisma 7 does not load .env automatically: export these variables (e.g.
# `set -a; . ./.env; set +a`) or use your process manager's env support.

DATABASE_URL="postgresql://user:password@localhost:5432/aif_local"
PORT=4000

# ── Access control (required; API refuses all /api requests without it) ──
# Generate locally, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_API_TOKEN=
# Comma-separated browser origins allowed by CORS. Unset = no cross-origin access.
FRONTEND_URL=http://localhost:5173
# Set to 1 only when running behind a single trusted reverse proxy.
TRUST_PROXY=
API_RATE_LIMIT_PER_MIN=300
GENERATION_RATE_LIMIT_PER_MIN=10

# ── Paid generation gate: everything below stays EMPTY until the owner approves ──
# Higgsfield is the selected primary image provider; the exact model/API route is
# not yet verified or approved. No video provider is selected.
IMAGE_PROVIDER=higgsfield:soul
VIDEO_PROVIDER=
# Owner-approved provider:model pairs (empty = nothing approved).
APPROVED_PROVIDER_MODELS=
# Must be exactly "enabled" to allow any network call to a provider.
LIVE_PROVIDER_CALLS=disabled
# Verified per-job price estimates, e.g. {"higgsfield:soul":"0.00"}. Unknown price blocks.
PROVIDER_PRICES_USD=
SPEND_CAP_PER_JOB_USD=
SPEND_CAP_DAILY_USD=
SPEND_CAP_MONTHLY_USD=
# Spending ledger. Default (unset/"memory") is NOT durable, which keeps paid
# generation blocked. "postgres" uses the generation_reservations table and is
# an owner decision, made together with approval, prices and caps.
SPEND_LEDGER=

# Provider credentials: only set server-side, only after approval.
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=
